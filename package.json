{
  "name": "tramia",
  "private": true,
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server-runtime.ts",
    "build": "vite build && esbuild server-runtime.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx database/seed.ts",
    "db:seed:visa-b1b2": "tsx scripts/seed-us-visa-b1b2.ts",
    "admin:assign": "tsx scripts/assign-role.ts",
    "admin:create-local": "tsx scripts/create-local-admin.ts",
    "demo:advisors": "tsx scripts/seed-demo-advisors.ts",
    "security:check": "node scripts/check-committed-secrets.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "quality": "npm run lint && npm run db:check && npm run security:check && npm run encoding:check && npm run build",
    "version:check": "node scripts/verify-release-tag.mjs",
    "preversion": "npm run lint && npm run build",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.0.2",
    "@netlify/blobs": "^10.7.13",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
