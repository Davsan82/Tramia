# La integración de IA está desactivada temporalmente. Cuando se seleccione un
# proveedor, agrega su configuración aquí y mantenla siempre del lado servidor.
# GEMINI_API_KEY=""

# DATABASE_URL: Neon Postgres connection string. Keep this value server-side.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# PORT: HTTP port used by the Express server.
PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
