# La integración de IA está desactivada temporalmente. Cuando se seleccione un
# proveedor, agrega su configuración aquí y mantenla siempre del lado servidor.
# GEMINI_API_KEY=""

# DATABASE_URL: Neon Postgres connection string. Keep this value server-side.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# URL directa de la misma rama, usada exclusivamente por drizzle-kit al migrar.
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# PORT: HTTP port used by the Express server.
PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Authentication and encryption. Use long random values and keep them server-side.
SESSION_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
DATA_ENCRYPTION_KEY="CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_VALUE"

# Gmail SMTP. Create an App Password; never use or commit the Gmail account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="davsan82@gmail.com"
SMTP_APP_PASSWORD=""
MAIL_FROM="TramIA Soporte <davsan82@gmail.com>"
SUPPORT_EMAIL="davsan82@gmail.com"

# PeruDevs is called only from the server. Add the token later.
PERUDEVS_API_KEY=""
PERUDEVS_BASE_URL="https://api.perudevs.com/api/v1"
